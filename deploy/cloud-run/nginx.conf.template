# Rendered by the nginx image entrypoint (envsubst replaces only ${PORT}; nginx variables are kept).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml
               application/manifest+json text/plain;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Hashed build output never changes: cache for a year. (expires, not add_header, so the
    # security headers above stay inherited by every location.)
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # The PWA shell and service worker must always be revalidated or updates never reach users.
    location = /sw.js {
        expires -1;
        try_files $uri =404;
    }
    location = /index.html {
        expires -1;
    }
    location = /manifest.webmanifest {
        expires -1;
        default_type application/manifest+json;
    }

    # Client-side routing (/v/demo, /ip/<code>, /venues ...) falls back to the SPA shell;
    # multi-page folders (landing: /privasi/, /trial/verifikasi/) resolve through $uri/.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
