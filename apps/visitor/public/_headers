# Cloudflare Pages (hosting). CSP sama dengan snippet csp_app di deploy/Caddyfile (on-premise).
# no-transform mencegah Cloudflare menyisipkan skrip inline JavaScript Detections ke HTML (ditolak CSP
# ini); aset hasil build tetap boleh dikompresi. Beacon Pages Analytics ditanam Pages saat deploy, bukan
# di edge, jadi domainnya diizinkan di script-src.
# Tanpa frame-ancestors: embed peta di situs klien adalah fitur (T-556).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate
