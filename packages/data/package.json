{
  "name": "@indoor/data",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing/full-venue": "./test/support/full-venue.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "node ../../scripts/with-supabase-env.mjs vitest run --config vitest.integration.config.ts",
    "seed:demo": "node ../../scripts/with-supabase-env.mjs vitest run --config vitest.seed.config.ts"
  },
  "dependencies": {
    "@indoor/domain": "workspace:*",
    "@supabase/supabase-js": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
