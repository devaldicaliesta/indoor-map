# Salin ke .env.local lalu isi. .env.local tidak pernah di-commit.

# Password Super Admin lokal (admin@local.test) yang dibuat seed; minimal 8 karakter.
# Dipakai oleh `pnpm db:reset`.
SEED_ADMIN_PASSWORD=

# Koneksi app ke Supabase lokal; nilai dari `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Alamat layanan konversi DXF (services/cad-converter); kosong = unggah DXF dinonaktifkan.
VITE_CAD_CONVERTER_URL=http://127.0.0.1:8090

# Landing (T-616): Visitor ter-hosting untuk tombol "Lihat demo" (`/v/demo`); kosong = alamat
# produksi https://app.panduarah.my.id. Form trial memakai VITE_SUPABASE_URL di atas.
VITE_VISITOR_URL=http://localhost:5174
