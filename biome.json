{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!e2e/evidence/**/*.html"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "includes": ["**", "!**/database.types.ts"],
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@supabase/**"],
                "message": "Hanya packages/data yang boleh mengimpor Supabase; pakai repository dari @indoor/data."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "maplibre-gl",
                      "maplibre-gl/**",
                      "@supabase/**"
                    ],
                    "message": "packages/domain harus murni: tanpa React, MapLibre, atau Supabase (docs/03-arsitektur.md)."
                  },
                  {
                    "group": ["@indoor/**"],
                    "message": "packages/domain tidak bergantung pada paket lain di repo."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/routing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "maplibre-gl",
                      "maplibre-gl/**",
                      "@supabase/**"
                    ],
                    "message": "packages/routing harus murni: tanpa React, MapLibre, atau Supabase (docs/03-arsitektur.md)."
                  },
                  {
                    "group": ["@indoor/data", "@indoor/map-core", "@indoor/ui"],
                    "message": "packages/routing hanya boleh bergantung pada @indoor/domain."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/map-core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@indoor/data", "@supabase/**"],
                    "message": "packages/map-core tidak mengakses data; terima data lewat argumen."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/data/**", "supabase/functions/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
