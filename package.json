{
  "name": "indoor-nav",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@indoor/landing --filter=!@indoor/vendor",
    "dev:landing": "pnpm --filter @indoor/landing dev",
    "dev:vendor": "pnpm --filter @indoor/vendor dev",
    "build": "turbo run build",
    "check": "turbo run typecheck lint test",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed-demo": "pnpm --filter @indoor/data seed:demo",
    "db:seed-demo:hosted": "pnpm --filter @indoor/data seed:demo:hosted",
    "db:types": "supabase gen types typescript --local > packages/data/src/database.types.ts && biome format --write packages/data/src/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
